# Two Points website: server settings for Apache / LiteSpeed hosting (Hostinger web hosting reads this file).

Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Always use https://www.twopoints.co.nz
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(twopoints\.co\.nz)$ [NC]
RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301,NE]

# Pages from the old site, sent to the matching part of the new one
RewriteRule ^about/?$ /#about [L,R=301,NE]
RewriteRule ^contact/?$ /#contact [L,R=301,NE]
RewriteRule ^offering/?$ /#services [L,R=301,NE]
RewriteRule ^(services|our-services)/?$ /#services [L,R=301,NE]
RewriteRule ^(projects|gallery)/?$ /#projects [L,R=301,NE]
RewriteRule ^(shop|store|products)/?$ /products.html [L,R=301,NE]
RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

# Keep the site's code, notes and Git files private
<FilesMatch "^(README\.md|\.nojekyll|\.gitignore|.*\.zip)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git(/|$)

# Compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json application/manifest+json text/plain application/xml
</IfModule>

# Cache images, video, fonts and the certificate for a month; pages, CSS and JS for an hour so updates show quickly
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

AddType application/manifest+json .webmanifest
