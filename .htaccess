# Two Points website: server settings for Apache / LiteSpeed hosting (Hostinger web hosting reads this file).

Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Always use https://www.twopoints.co.nz
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(twopoints\.co\.nz)$ [NC]
RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301,NE]

# Pages from the old site, sent to the matching part of the new one
RewriteRule ^about/?$ /#about [L,R=301,NE]
RewriteRule ^contact/?$ /#contact [L,R=301,NE]
RewriteRule ^offering/?$ /#services [L,R=301,NE]
RewriteRule ^(services|our-services)/?$ /#services [L,R=301,NE]
RewriteRule ^(projects|gallery)/?$ /#projects [L,R=301,NE]
RewriteRule ^(shop|store|products)/?$ /products.html [L,R=301,NE]
RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

# Keep the site's code, notes and Git files private
<FilesMatch "^(README\.md|\.nojekyll|\.gitignore|.*\.zip)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git(/|$)

# Compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json application/manifest+json text/plain application/xml
</IfModule>

# Cache images, video, fonts and the certificate for a month; pages, CSS and JS for an hour so updates show quickly
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Browsers always use the secure connection for the next 6 months
  Header always set Strict-Transport-Security "max-age=15552000"
  # The site never needs the camera, microphone, location or payment APIs
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  # Only the site's own files and Google Fonts may load. If the Shopify cart is switched back on,
  # add the store's domain to connect-src.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

AddType application/manifest+json .webmanifest

# The internal email-signature page: email signatures need inline styles, so this one page allows them
<Files "email-signature.html">
  <IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
    Header always set X-Robots-Tag "noindex, nofollow"
  </IfModule>
</Files>
